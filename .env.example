# Copy to .env and adjust. docker compose reads it automatically.

# ---- App ----
POSTGRES_PASSWORD=change-me
APP_PORT=8000
WEB_CONCURRENCY=4

# ---- PostgreSQL tuning ----
# Defaults (in docker-compose.yml) are safe on a small host. The values below
# are a good starting point for a big server (~64 GB RAM / 16 CPU). Rule of
# thumb: shared_buffers ~= 25% of RAM, effective_cache_size ~= 50-75% of RAM,
# and the parallel-worker counts ~= your CPU count (this is what lets a single
# heavy query spread across cores).
PG_SHARED_BUFFERS=16GB
PG_EFFECTIVE_CACHE_SIZE=48GB
PG_WORK_MEM=256MB
PG_MAINTENANCE_WORK_MEM=2GB
PG_MAX_WORKER_PROCESSES=16
PG_MAX_PARALLEL_WORKERS=16
PG_MAX_PARALLEL_WORKERS_PER_GATHER=8

# ---- Import / search ----
# IMPORT_BATCH_SIZE=50000
# Build a trigram index for fast "path contains" search. Big win on large
# datasets, but makes imports ~40% slower (the index is maintained during load).
# ENABLE_TRGM_INDEX=1
